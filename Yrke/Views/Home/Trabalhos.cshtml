@{
    ViewData["Title"] = "Calendário de Plantões";
}

<style>
    body {
        background: #f4f6f9;
    }

    .page-container {
        padding: 30px;
    }

    /* HEADER */
    .page-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #1f2937;
    }

    /* GRID PRINCIPAL */
    .layout {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 25px;
        align-items: start;
    }

    /* CARD PADRÃO */
    .card {
        background: #fff;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.10);
        }

    /* TITULOS */
    .card-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .title-blue {
        color: #2563eb;
    }

    .title-yellow {
        color: #f59e0b;
    }

    /* CALENDÁRIO */
    .calendar {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }

    .day {
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        background: #f3f4f6;
        cursor: pointer;
        transition: 0.2s;
    }

        .day:hover {
            background: #e5e7eb;
        }

        /* SEUS PLANTÕES */
        .day.blue {
            background: #2563eb;
            color: white;
        }

        /* DIAS PARA TROCA */
        .day.yellow {
            background: #fbbf24;
            color: #1f2937;
        }

    /* BOTÃO CENTRAL */
    .center {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .btn-swap {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: white;
        border: none;
        padding: 14px 18px;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(34,197,94,0.3);
        transition: 0.3s;
    }

        .btn-swap:hover {
            transform: scale(1.05);
        }

    /* SELECT */
    select {
        width: 100%;
        margin-top: 12px;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        outline: none;
    }

    /* TROCAS */
    .swap-section {
        margin-top: 30px;
    }

    .swap-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 15px;
        color: #111827;
    }

    .swap-item {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 10px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
        border-left: 5px solid #f59e0b;
    }

    .status-approved {
        background: #dcfce7;
        color: #166534;
        border-left: 5px solid #22c55e;
    }

    .status-rejected {
        background: #fee2e2;
        color: #991b1b;
        border-left: 5px solid #ef4444;
    }

    /* RESPONSIVO */
    @@media (max-width: 900px) {
        .layout {
            grid-template-columns: 1fr;
        }

        .center {
            margin: 20px 0;
        }
    }
</style>

<div class="page-container">

    <div class="page-title">📅 Plantões</div>

    <!-- LAYOUT -->
    <div class="layout">

        <!-- SEUS PLANTÕES -->
        <div class="card">
            <div class="card-title title-blue">Seus Plantões</div>

            <div class="calendar">
                @for (int i = 1; i <= 30; i++)
                {
                    var plantao = (i % 4 == 0);
                    <div class="day @(plantao ? "blue" : "")">
                        @i
                    </div>
                }
            </div>
        </div>

        <!-- BOTÃO CENTRAL -->
        <div class="center">
            <button class="btn-swap">🔄 Solicitar troca</button>
        </div>

        <!-- DIAS PARA TROCA -->
        <div class="card">
            <div class="card-title title-yellow">Dias para troca</div>

            <div class="calendar">
                @for (int i = 1; i <= 30; i++)
                {
                    <div class="day yellow">@i</div>
                }
            </div>

            <label style="margin-top:15px; display:block; font-weight:600;">
                Trocar com
            </label>

            <select>
                <option>Ana Paula</option>
                <option>Carlos Silva</option>
                <option>Mariana Souza</option>
                <option>João Pedro</option>
            </select>
        </div>

    </div>

    <!-- TROCAS -->
    <div class="swap-section">

        <div class="swap-title">📌 Próximas trocas</div>

        <div class="swap-item status-pending">
            João → Ana Paula <span>⏳ Pendente</span>
        </div>

        <div class="swap-item status-approved">
            Carlos → Maria <span>✅ Aceita</span>
        </div>

        <div class="swap-item status-rejected">
            Pedro → Lucas <span>❌ Negada</span>
        </div>

    </div>

</div>