@model Yrke.ViewModels.PerfilViewModel

@{
    ViewData["Title"] = "Meu Perfil";
}

<link rel="stylesheet" href="~/css/perfil.css" />

<div class="container-perfil">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="logo">Gestão HR</div>
        <nav>
            <a href="#">Dashboard</a>
            <a href="#" class="active">Meu Perfil</a>
        </nav>
    </aside>

    <!-- Conteúdo -->
    <main class="content">
        <h1>Meu Perfil</h1>

        <form asp-action="EditarPerfil" method="post" enctype="multipart/form-data" class="card">

            <!-- ID oculto -->
            <input type="hidden" asp-for="Id" />

            <!-- FOTO -->
            <div class="perfil-header">
                <div class="avatar">
                    <img src="@Model.UrlFoto" alt="Foto do usuário" />

                    <label class="btn-upload">
                        📷
                        <input type="file" asp-for="FotoFile" hidden />
                    </label>
                </div>

                <div class="perfil-info">
                    <h2>@Model.Nome</h2>
                    <p>@Model.Funcao</p>
                </div>
            </div>

            <!-- ERROS -->
            <div asp-validation-summary="All" class="validation"></div>

            <!-- CAMPOS -->
            <div class="grid">

                <div class="form-group">
                    <label>Nome Completo</label>
                    <input asp-for="Nome" class="input" />
                    <span asp-validation-for="Nome" class="error"></span>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="input" />
                    <span asp-validation-for="Email" class="error"></span>
                </div>

                <div class="form-group">
                    <label>Telefone</label>
                    <input asp-for="Telefone" class="input" />
                </div>

                <div class="form-group">
                    <label>Função</label>
                    <input asp-for="Funcao" class="input" />
                    <span asp-validation-for="Funcao" class="error"></span>
                </div>

                <div class="form-group">
                    <label>Tipo de Escala</label>
                    <input asp-for="TipoEscala" class="input" />
                    <span asp-validation-for="TipoEscala" class="error"></span>
                </div>

            </div>

            <!-- BOTÃO -->
            <div class="actions">
                <button type="submit" class="btn-save">
                    Salvar Alterações
                </button>
            </div>

        </form>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}