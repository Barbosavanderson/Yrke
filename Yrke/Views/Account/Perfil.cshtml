@model Yrke.ViewModels.PerfilViewModel

<div class="min-h-screen bg-slate-50 flex">
    <!-- Sidebar (Exemplo simplificado) -->
    <aside class="w-64 bg-slate-900 text-white hidden md:block">
        <div class="p-4 text-xl font-bold">Gestão HR</div>
        <nav class="mt-4">
            <a href="#" class="block py-2.5 px-4 hover:bg-slate-800">Dashboard</a>
            <a href="#" class="block py-2.5 px-4 bg-blue-600">Meu Perfil</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8">
        <h1 class="text-2xl font-semibold text-slate-800 mb-6">Meu Perfil</h1>

        <form asp-action="EditarPerfil" method="post" enctype="multipart/form-data" class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
            <!-- Foto -->
            <div class="flex items-center gap-6 mb-8">
                <div class="relative">
                    <img src="~/images/avatar-default.png" class="w-24 h-24 rounded-full object-cover border-2 border-slate-200" />
                    <button type="button" class="absolute bottom-0 right-0 bg-blue-600 p-2 rounded-full text-white">
                        <i class="fas fa-camera"></i>
                    </button>
                </div>
                <div>
                    <h2 class="text-lg font-medium text-slate-900">@Model.Nome</h2>
                    <p class="text-slate-500">@Model.Funcao</p>
                </div>
            </div>

            <!-- Campos -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Nome Completo</label>
                    <input asp-for="Nome" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                </div>
                <!-- Adicione os outros campos seguindo o mesmo padrão -->
            </div>

            <div class="mt-6 flex justify-end">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Salvar Alterações</button>
            </div>
        </form>
    </main>
</div>
