@model Yrke.ViewModels.RecuperarSenhaViewModel
@{
    ViewData["Title"] = "Recuperar Senha";
}

<div class="form-card-container">
    <div class="form-card">
        <h3 class="text-center mb-3" style="color: var(--yrke-primary); font-weight: bold;">Recuperar Senha</h3>
        <p class="text-center text-muted mb-4">Informe seu e-mail para receber o link de redefinição.</p>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success text-center">
                @ViewBag.Message
            </div>
        }

        <form asp-action="RecuperarSenha" method="post">
            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-bold"></label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="seu@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-yrke w-100 btn-lg mb-3">Enviar link</button>

            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted">Voltar para o Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}