@model Yrke.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Cadastro";
}

<div class="form-card-container">
    <div class="form-card">
        <h3 class="text-center mb-4" style="color: var(--yrke-primary); font-weight: bold;">Criar Conta</h3>

        <form asp-action="Cadastrar" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-bold"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefone" class="form-label fw-bold"></label>
                    <input asp-for="Telefone" class="form-control" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Funcao" class="form-label fw-bold"></label>
                    <input asp-for="Funcao" class="form-control" />
                    <span asp-validation-for="Funcao" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="TipoEscala" class="form-label fw-bold"></label>
                <input asp-for="TipoEscala" class="form-control" />
                <span asp-validation-for="TipoEscala" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Senha" class="form-label fw-bold"></label>
                    <input asp-for="Senha" type="password" class="form-control" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="ConfirmarSenha" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-yrke w-100 btn-lg">Cadastrar</button>

            <div class="text-center mt-3">
                <span class="text-muted">Já tem uma conta?</span>
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--yrke-primary);">Faça Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}