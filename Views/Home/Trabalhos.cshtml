@{
    ViewData["Title"] = "Sistema de Plantões";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<style>
    body {
        background: #f4f6f9;
    }

    .page {
        padding: 30px;
    }

    .header h1 {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .header p {
        color: #6b7280;
        margin-bottom: 20px;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 20px;
        align-items: start;
    }

    .card {
        background: white;
        border-radius: 14px;
        padding: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    .title {
        font-weight: 700;
        margin-bottom: 10px;
    }

    #calendar-plantoes,
    #calendar-troca {
        max-height: 500px;
    }

    .btn {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: white;
        border: none;
        padding: 14px 18px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    /* TROCAS */
    .swap {
        margin-top: 30px;
    }

    .swap-item {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .yellow {
        background: #fef3c7;
        color: #92400e;
    }

    .green {
        background: #dcfce7;
        color: #166534;
    }

    .red {
        background: #fee2e2;
        color: #991b1b;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<div class="page">

    <div class="header">
        <h1>📅 Plantões</h1>
        <p>Gerencie seus plantões e trocas com facilidade</p>
    </div>

    <div class="grid">

        <!-- 🔵 SEUS PLANTÕES -->
        <div class="card">
            <div class="title">Seus Plantões</div>
            <div id="calendar-plantoes"></div>
        </div>

        <!-- BOTÃO -->
        <div style="display:flex; align-items:center; justify-content:center;">
            <button class="btn btn-success" id="btnSolicitarTroca">🔄 Solicitar troca</button>
        </div>

        <!-- 🟡 TROCAS -->
        <div class="card">
            <div class="title">Dias para troca</div>
            <div id="calendar-troca"></div>
        </div>

    </div>

    <!-- TROCAS -->
    <div class="swap mt-3">
        <h3>📌 Próximas trocas</h3>
        <div class="swap-item yellow">João → Ana Paula (Aguardando confirmação)</div>
        <div class="swap-item green">Carlos → Maria (Aceita)</div>
        <div class="swap-item red">Pedro → Lucas (Negada)</div>
    </div>
</div>

<!-- Modal Solicitar Troca -->
<div class="modal fade" id="modalTroca" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- centralizado e grande -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Solicitar Troca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Selecione colega:</label>
                <select id="colegaSelect" class="form-select">
                    <option value="">Carregando...</option>
                </select>

                <label class="mt-2">Seu plantão:</label>
                <input id="plantaoA" type="date" class="form-control" />

                <label class="mt-2">Dia para troca:</label>
                <input id="plantaoB" type="date" class="form-control" />

                <label class="mt-2">Observação:</label>
                <textarea id="observacao" class="form-control"></textarea>

                <hr>
                <div id="previewTermo" style="background:#f9fafb;padding:10px;border-radius:8px;">
                    <strong>Resumo da troca:</strong><br>
                    Você → <span id="previewColega"></span><br>
                    Seu plantão: <span id="previewA"></span><br>
                    Dia para troca: <span id="previewB"></span><br>
                    Observação: <span id="previewObs"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnConfirmarTroca" class="btn btn-success">Confirmar Solicitação</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-50 start-50 translate-middle p-3" style="z-index: 1100">
    <div id="toastFeedback" class="toast align-items-center text-bg-success border-10 fs-4" role="alert" data-bs-delay="3000">
        <div class="d-flex">
            <div class="toast-body">
                ✅ Troca registrada com sucesso!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const today = new Date();
        const maxDate = new Date();
        maxDate.setMonth(today.getMonth() + 4);

        // 🔵 CALENDÁRIO DE PLANTÕES (AGORA DO BANCO)
        fetch('/Plantao/Listar')
            .then(res => res.json())
            .then(eventsPlantoes => {

                const calendarPlantoes = new FullCalendar.Calendar(
                    document.getElementById('calendar-plantoes'),
                    {
                        initialView: 'dayGridMonth',
                        locale: 'pt-br',
                        height: 500,
                        validRange: { start: today, end: maxDate },
                        headerToolbar: { left: 'prev,next', center: 'title', right: '' },
                        events: eventsPlantoes
                    }
                );

                calendarPlantoes.render();
            });

        // 🟡 CALENDÁRIO DE TROCA (por enquanto vazio)
        const calendarTroca = new FullCalendar.Calendar(
            document.getElementById('calendar-troca'),
            {
                initialView: 'dayGridMonth',
                locale: 'pt-br',
                height: 500,
                validRange: { start: today, end: maxDate },
                headerToolbar: { left: 'prev,next', center: 'title', right: '' },
                events: [],
                dateClick: function(info) {
                    document.getElementById("plantaoB").value = info.dateStr;
                    document.getElementById("previewB").innerText = info.dateStr;

                    var modal = new bootstrap.Modal(document.getElementById('modalTroca'));
                    modal.show();
                }
            }
        );

        calendarTroca.render();

        // � Carregar usuários para o select
        function carregarUsuarios() {
            fetch('/api/TrocaPlantao/usuarios')
                .then(res => res.json())
                .then(usuarios => {
                    const select = document.getElementById('colegaSelect');
                    select.innerHTML = '<option value="">Selecione um colega</option>';
                    usuarios.forEach(u => {
                        const option = document.createElement('option');
                        option.value = u.id;
                        option.text = `${u.nome} (${u.funcao})`;
                        select.appendChild(option);
                    });
                })
                .catch(err => {
                    console.error('Erro ao carregar usuários:', err);
                    document.getElementById('colegaSelect').innerHTML = '<option value="">Erro ao carregar usuários</option>';
                });
        }

        // 🔘 Botão abrir modal
        document.getElementById("btnSolicitarTroca").addEventListener("click", function() {
            carregarUsuarios();
            var modal = new bootstrap.Modal(document.getElementById('modalTroca'));
            modal.show();
        });

        // Atualizar preview quando seleciona colega
        document.getElementById("colegaSelect").addEventListener("change", function() {
            const selectedOption = this.options[this.selectedIndex];
            document.getElementById("previewColega").innerText = selectedOption.text || '';
        });

        // ✅ Confirmar troca
        document.getElementById("btnConfirmarTroca").addEventListener("click", function() {
            const colegaSelect = document.getElementById("colegaSelect");
            const plantaoA = document.getElementById("plantaoA").value;
            const plantaoB = document.getElementById("plantaoB").value;
            const observacao = document.getElementById("observacao").value;

            if (!colegaSelect.value || !plantaoA || !plantaoB) {
                alert("Preencha todos os campos obrigatórios");
                return;
            }

            // Preparar dados para envio
            const trocaData = {
                destinatarioId: colegaSelect.value,
                plantaoA: new Date(plantaoA).toISOString().split('T')[0],
                plantaoB: new Date(plantaoB).toISOString().split('T')[0]
            };

            // Enviar para backend
            fetch('/api/TrocaPlantao/solicitar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(trocaData)
            })
            .then(res => {
                if (!res.ok) throw new Error('Erro ao registrar troca');
                return res.json();
            })
            .then(data => {
                // Atualizar preview
                document.getElementById("previewA").innerText = plantaoA;
                document.getElementById("previewB").innerText = plantaoB;
                document.getElementById("previewObs").innerText = observacao || '(nenhuma)';

                var modal = bootstrap.Modal.getInstance(document.getElementById('modalTroca'));
                modal.hide();

                // Limpar formulário
                colegaSelect.value = '';
                document.getElementById("plantaoA").value = '';
                document.getElementById("plantaoB").value = '';
                document.getElementById("observacao").value = '';

                // Mostrar toast de sucesso
                var toastEl = document.getElementById('toastFeedback');
                var toast = new bootstrap.Toast(toastEl, { delay: 5000 });
                toast.show();
            })
            .catch(err => {
                console.error('Erro:', err);
                alert('Erro ao registrar troca: ' + err.message);
            });
        });

    });
</script>